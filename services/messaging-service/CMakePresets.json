{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "include": [
        "../../CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "messaging-dev",
            "displayName": "Messaging Service Development",
            "description": "Development build for Messaging Service using root presets",
            "inherits": "dev",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BUILD_GATEWAY": "OFF",
                "BUILD_AUTH_SERVICE": "OFF",
                "BUILD_MESSAGING_SERVICE": "ON",
                "BUILD_QT_CLIENT": "OFF"
            }
        }
    ]
}

{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Development (Debug)",
      "description": "Development build with Debug configuration for Windows MSYS2 UCRT64",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "BUILD_GATEWAY": "ON",
        "BUILD_AUTH_SERVICE": "ON",
        "BUILD_QT_CLIENT": "ON",
        "BUILD_TESTING": "ON"
      },
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev-gateway-only",
      "displayName": "Development - Gateway Only",
      "description": "Build only the Gateway component",
      "inherits": "dev",
      "cacheVariables": {
        "BUILD_GATEWAY": "ON",
        "BUILD_AUTH_SERVICE": "OFF",
        "BUILD_QT_CLIENT": "OFF"
      }
    },
    {
      "name": "dev-auth-only",
      "displayName": "Development - Auth Service Only",
      "description": "Build only the Auth Service component",
      "inherits": "dev",
      "cacheVariables": {
        "BUILD_GATEWAY": "OFF",
        "BUILD_AUTH_SERVICE": "ON",
        "BUILD_QT_CLIENT": "OFF"
      }
    },
    {
      "name": "dev-client-only",
      "displayName": "Development - Qt Client Only",
      "description": "Build only the Qt Client",
      "inherits": "dev",
      "cacheVariables": {
        "BUILD_GATEWAY": "OFF",
        "BUILD_AUTH_SERVICE": "OFF",
        "BUILD_QT_CLIENT": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with optimizations for Windows MSYS2 UCRT64",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "BUILD_GATEWAY": "ON",
        "BUILD_AUTH_SERVICE": "ON",
        "BUILD_QT_CLIENT": "ON",
        "BUILD_TESTING": "OFF"
      },
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-dev",
      "displayName": "Linux Development",
      "description": "Development build for Linux",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_GATEWAY": "ON",
        "BUILD_AUTH_SERVICE": "ON",
        "BUILD_QT_CLIENT": "ON",
        "BUILD_TESTING": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "description": "Release build for Linux",
      "inherits": "linux-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "dev-makefiles",
      "displayName": "Development (Makefiles fallback)",
      "description": "Fallback for devs without Ninja. Install Ninja: pacman -S mingw-w64-ucrt-x86_64-ninja",
      "inherits": "base",
      "generator": "MinGW Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "BUILD_GATEWAY": "ON",
        "BUILD_AUTH_SERVICE": "ON",
        "BUILD_QT_CLIENT": "ON",
        "BUILD_TESTING": "ON"
      },
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "displayName": "Build Development",
      "configurePreset": "dev",
      "jobs": 0
    },
    {
      "name": "dev-verbose",
      "displayName": "Build Development (Verbose)",
      "configurePreset": "dev",
      "verbose": true,
      "jobs": 0
    },
    {
      "name": "dev-makefiles",
      "displayName": "Build Development (Makefiles)",
      "configurePreset": "dev-makefiles",
      "jobs": 0
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "release"
    },
    {
      "name": "gateway-only",
      "displayName": "Build Gateway Only",
      "configurePreset": "dev-gateway-only",
      "targets": ["gateway"]
    },
    {
      "name": "auth-only",
      "displayName": "Build Auth Service Only",
      "configurePreset": "dev-auth-only",
      "targets": ["auth-service"]
    },
    {
      "name": "client-only",
      "displayName": "Build Qt Client Only",
      "configurePreset": "dev-client-only",
      "targets": ["MSF_Login"]
    },
    {
      "name": "linux-dev",
      "displayName": "Build Linux Development",
      "configurePreset": "linux-dev"
    },
    {
      "name": "linux-release",
      "displayName": "Build Linux Release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "displayName": "Test Development",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-verbose",
      "displayName": "Test Development (Verbose)",
      "configurePreset": "dev",
      "output": {
        "verbosity": "verbose",
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "full-dev",
      "displayName": "Full Development Workflow",
      "description": "Configure, build, and test in development mode",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    },
    {
      "name": "release-build",
      "displayName": "Release Build Workflow",
      "description": "Configure and build in release mode",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        }
      ]
    }
  ]
}
